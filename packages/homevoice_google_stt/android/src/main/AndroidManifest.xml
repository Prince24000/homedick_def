<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The app already holds this for its own capture; some recognisers
         check it on the caller even when fed audio. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Android 11+ package visibility: without this the recogniser
         service is invisible and every call reports "not available". -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
</manifest>
